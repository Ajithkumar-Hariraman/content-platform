NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://cloudops:local-development-password@127.0.0.1:55433/cloudops
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=local-development-password
POSTGRES_DB=cloudops
POSTGRES_HOST_PORT=55433

AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://127.0.0.1:58000
DYNAMODB_ACTIVITY_TABLE=activity_events
DYNAMODB_HOST_PORT=58000
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25

SESSION_LIFETIME_HOURS=8
ENABLE_API_DOCS=false
DEV_ADMIN_EMAIL=admin@cloudops.local
DEV_ADMIN_PASSWORD=

REDIS_HOST_PORT=56379
REDIS_URL=redis://127.0.0.1:56379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_TIMEOUT_MS=150
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
SLOW_REQUEST_THRESHOLD_MS=500
PERFORMANCE_MODE=false
